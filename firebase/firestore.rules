rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles — document ID must equal Firebase Auth UID.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.accountRole == 'user';

      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.accountRole == resource.data.accountRole;

      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Citizen science GoPro scan records (image-only submissions).
    match /scan_records/{recordId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.capture_source == 'GoPro Underwater Image'
        && request.resource.data.citizen_contribution == true
        && request.resource.data.activity_type in ['detection_only', 'removal_activity'];

      allow update, delete: if false;
    }
  }
}
